[Unit]
Description=Keep allowlisted Android devices available through ADB over Wi-Fi
Documentation=file://%h/projects/adb-device-keeper/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/adb-device-keeper --daemon
Environment=HOME=%h
Environment=ANDROID_HOME=%h/Android/Sdk
Environment=ANDROID_SDK_ROOT=%h/Android/Sdk
Environment=PATH=/usr/bin:/bin
Environment=ADB_MDNS=1
Environment=ADB_MDNS_OPENSCREEN=0
Environment=ADB_MDNS_AUTO_CONNECT=0
UMask=0077
Restart=always
RestartSec=30
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=default.target
